VENDOR_SERVICE_PORT=
MONGO_URI= 
MONGO_DB_NAME= 
MONGO_VENDOR_COLLECTION= 
EMBEDDING_MODEL_NAME= 
EMBEDDING_DEVICE=
EMBEDDING_REQUIRE_GPU=

# Cloud-based Ollama Configuration for RAG System
OLLAMA_CLOUD_URL=https://ollama.ai/api
OLLAMA_CLOUD_MODEL=glm-4.6:cloud

# Local Ollama Fallback (optional)
USE_LOCAL_OLLAMA_FALLBACK=false
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2:3b

# Ollama Settings
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_TIMEOUT=30
ENABLE_LLM_FALLBACK=true

MIN_SIMILARITY_THRESHOLD=
MAX_RESULTS=
