# ComfyUI Configuration
COMFYUI_URL=http://127.0.0.1:8000
COMFYUI_TIMEOUT=300

# ComfyUI Model Configuration (based on your setup)
COMFYUI_MODEL_PATH=D:/ComfyUI/models
COMFYUI_OUTPUT_PATH=D:/ComfyUI/output
COMFYUI_INPUT_PATH=D:/ComfyUI/input

# Text Encoder Model
TEXT_ENCODER_MODEL=qwen_3_4b.safetensors

# Diffusion Model (Z-Image Turbo)
DIFFUSION_MODEL=z_image_turbo_bf16.safetensors

# VAE Model
VAE_MODEL=ae.safetensors

# Image Generation Settings
DEFAULT_IMAGE_WIDTH=1024
DEFAULT_IMAGE_HEIGHT=1024
DEFAULT_SEED=random

# Ollama Configuration for Prompt Enhancement
# Cloud-based Ollama (Same as vendor service)
OLLAMA_CLOUD_URL=https://ollama.ai
OLLAMA_CLOUD_MODEL=glm-4.6:cloud

# Local Ollama Fallback (optional)
USE_LOCAL_OLLAMA_FALLBACK=false
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.2:3b

# Ollama Settings
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_TIMEOUT=60
ENABLE_LLM_FALLBACK=true

# Cloudinary Configuration (for storing generated images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Service Configuration
IMAGE_SERVICE_PORT=8003
IMAGE_SERVICE_HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
