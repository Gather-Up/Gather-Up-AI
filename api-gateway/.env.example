# ============================================================================
# API Gateway Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values

# Gateway Server Port
GATEWAY_PORT=8080

# ============================================================================
# Microservice URLs
# ============================================================================
VENDOR_SERVICE_URL=http://localhost:8001
LOCATION_SERVICE_URL=http://localhost:8002
IMAGE_SERVICE_URL=http://localhost:8003

# ============================================================================
# CORS Configuration
# ============================================================================
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ============================================================================
# Security Settings (Optional)
# ============================================================================
# Comma-separated list of trusted hosts
# TRUSTED_HOSTS=localhost,127.0.0.1

# ============================================================================
# MongoDB Database Configuration
# ============================================================================
# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com/
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Database name (default: GatherUp_Official_DB)
# DATABASE_NAME=GatherUp_Official_DB

# ============================================================================
# Cloudinary Configuration
# ============================================================================
# Image storage and CDN service
# Get your credentials from: https://cloudinary.com/console

# Your Cloudinary cloud name (from dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Your Cloudinary API key (from dashboard)
CLOUDINARY_API_KEY=your_api_key

# Your Cloudinary API secret (from dashboard - keep this secure!)
CLOUDINARY_API_SECRET=your_api_secret

# ============================================================================
# Ollama AI Configuration (for email generation)
# ============================================================================
# Ollama API endpoint (default: http://localhost:11434)
# OLLAMA_API_URL=http://localhost:11434

# Model to use for email generation (default: llama3.2:3b)
# OLLAMA_MODEL=llama3.2:3b

# ============================================================================
# Setup Instructions
# ============================================================================
#
# 1. MongoDB Setup:
#    - Create account at: https://cloud.mongodb.com/
#    - Create a cluster (free tier available)
#    - Create database user
#    - Get connection string
#    - Replace MONGODB_URI with your connection string
#
# 2. Cloudinary Setup:
#    - Create account at: https://cloudinary.com/users/register_free
#    - Navigate to Dashboard
#    - Copy: Cloud Name, API Key, API Secret
#    - Paste values above
#    - Free tier: 25GB storage, 25GB bandwidth/month
#
# 3. Ollama Setup (if not installed):
#    - Download from: https://ollama.ai/
#    - Run: ollama pull llama3.2:3b
#    - Ollama will run on http://localhost:11434
#
# ============================================================================
